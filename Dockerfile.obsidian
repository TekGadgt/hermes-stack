FROM node:26.6.0-bookworm-slim@sha256:81502e860176e63695d769d3d1a2d3a403abc1c27c6a02169b765f3e43b60ede

ARG OBSIDIAN_HEADLESS_VERSION=0.0.14

RUN npm install --global --allow-scripts=better-sqlite3 \
        "obsidian-headless@${OBSIDIAN_HEADLESS_VERSION}" \
    && test "$(ob --version)" = "${OBSIDIAN_HEADLESS_VERSION}" \
    && mkdir -p /state/obsidian-headless /vault \
    && chmod 0755 /state /state/obsidian-headless /vault

ENV HOME=/state
ENV XDG_CONFIG_HOME=/state

WORKDIR /vault

CMD ["ob", "sync", "--path", "/vault", "--continuous"]
