#!/command/with-contenv sh
set -eu

export HOME=/opt/data
export HERMES_HOME=/opt/data
export PATH=/opt/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin:/command:/package/admin/s6/command
export NODE_ENV=production
export NODE_OPTIONS="${OPEN_DESIGN_NODE_OPTIONS:---max-old-space-size=192}"

cd /opt/open-design

exec /command/s6-setuidgid hermes \
    /opt/open-design-node/bin/node \
    apps/daemon/dist/cli.js \
    --host 0.0.0.0 \
    --port 7456 \
    --no-open
