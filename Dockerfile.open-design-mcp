ARG OPEN_DESIGN_IMAGE=ghcr.io/nexu-io/od:latest
FROM ${OPEN_DESIGN_IMAGE}

USER root

ARG SUPERGATEWAY_VERSION=3.4.3

RUN npm install --global "supergateway@${SUPERGATEWAY_VERSION}" \
    && npm cache clean --force

COPY scripts/patch-open-design-mcp-context.mjs /usr/local/libexec/patch-open-design-mcp-context.mjs

RUN node /usr/local/libexec/patch-open-design-mcp-context.mjs \
    && rm /usr/local/libexec/patch-open-design-mcp-context.mjs
