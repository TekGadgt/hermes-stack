{
  "TCP": {
    "9119": {
      "HTTPS": true
    },
    "443": {
      "HTTPS": true
    },
    "3000": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:9119": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:9119"
        }
      }
    },
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:7456"
        }
      }
    },
    "${TS_CERT_DOMAIN}:3000": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:3000"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:9119": false,
    "${TS_CERT_DOMAIN}:443": false,
    "${TS_CERT_DOMAIN}:3000": false
  }
}
