ARG OPEN_DESIGN_REV=0c237048cb078f95ab01c416924dcb255f7d5dfd

FROM node:26.8.1-bookworm-slim@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e AS open-design-build

ARG OPEN_DESIGN_REV

ENV CI=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        make \
        g++ \
        python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/open-design

# Temporary upstream backport. Remove after OPEN_DESIGN_REV includes commit
# 85d2e4893c (fix(amr): recover expired cloud sessions, #6786).
COPY patches/open-design-v0.19-local-agent-cloud-gate.patch /tmp/open-design-local-agent-cloud-gate.patch

RUN git init \
    && git remote add origin https://github.com/nexu-io/open-design.git \
    && git fetch --depth 1 origin "${OPEN_DESIGN_REV}" \
    && git checkout --detach FETCH_HEAD \
    && git apply --check /tmp/open-design-local-agent-cloud-gate.patch \
    && git apply /tmp/open-design-local-agent-cloud-gate.patch \
    && corepack enable \
    && corepack prepare pnpm@10.33.2 --activate \
    && pnpm install --frozen-lockfile \
    && pnpm --filter @open-design/daemon build \
    && pnpm --filter @open-design/web build \
    && pnpm --filter @open-design/daemon deploy --legacy --prod /opt/open-design/apps/daemon

# Hermes Agent v0.20.4 (2026.8.18), upstream revision e624e9fd.
FROM nousresearch/hermes-agent:v2026.8.18@sha256:22e37bb4ed1b0f50cb6bd991dca7ecacd6c9f29df9b4a20fc989d32bc763ccf6

USER root

ARG PNPM_VERSION=11.21.0
ARG PLAYWRIGHT_VERSION=1.62.1

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN npm install --global \
    "pnpm@${PNPM_VERSION}" \
    "playwright@${PLAYWRIGHT_VERSION}" \
    && test "$(pnpm --version)" = "${PNPM_VERSION}" \
    && test "$(playwright --version)" = "Version ${PLAYWRIGHT_VERSION}" \
    && playwright install --with-deps \
    && chmod -R a+rX "${PLAYWRIGHT_BROWSERS_PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fish \
        poppler-utils \
    && /usr/sbin/usermod --shell /usr/bin/fish hermes \
    && rm -rf /var/lib/apt/lists/*

COPY --from=open-design-build /usr/local/bin/node /opt/open-design-node/bin/node
COPY --from=open-design-build /opt/open-design/apps/daemon /opt/open-design/apps/daemon
COPY --from=open-design-build /src/open-design/apps/web/out /opt/open-design/apps/web/out
COPY --from=open-design-build /src/open-design/skills /opt/open-design/skills
COPY --from=open-design-build /src/open-design/design-systems /opt/open-design/design-systems
COPY --from=open-design-build /src/open-design/craft /opt/open-design/craft
COPY --from=open-design-build /src/open-design/prompt-templates /opt/open-design/prompt-templates
COPY --from=open-design-build /src/open-design/assets/frames /opt/open-design/assets/frames
COPY --from=open-design-build /src/open-design/assets/community-pets /opt/open-design/assets/community-pets
COPY --from=open-design-build /src/open-design/plugins/_official /opt/open-design/plugins/_official
COPY skills/workspace-paths /opt/hermes/skills/workspace-paths

COPY docker/open-design-run /etc/s6-overlay/s6-rc.d/open-design/run
COPY docker/open-design-type /etc/s6-overlay/s6-rc.d/open-design/type
COPY docker/open-design-setup /etc/cont-init.d/03-open-design-setup
COPY docker/node-modules-setup /etc/cont-init.d/04-node-modules-setup

RUN mkdir -p \
        /etc/s6-overlay/s6-rc.d/open-design/dependencies.d \
        /opt/open-design-data \
        /run/hermes-stack \
    && touch \
        /etc/s6-overlay/s6-rc.d/open-design/dependencies.d/base \
        /etc/s6-overlay/s6-rc.d/user/contents.d/open-design \
    && chown -R hermes:hermes /opt/open-design-data \
    && chmod -R a+rX /opt/open-design /opt/open-design-node \
    && chmod 0755 \
        /etc/s6-overlay/s6-rc.d/open-design/run \
        /etc/cont-init.d/03-open-design-setup \
        /etc/cont-init.d/04-node-modules-setup
